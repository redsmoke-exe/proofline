LLM_PROVIDER=gemini
LLM_PARALLEL_PROVIDERS=true
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_FALLBACK_MODELS=openrouter/free
OPENROUTER_APP_NAME=Proofline CV Agent
OPENROUTER_REASONING_EFFORT=none
OPENROUTER_REASONING_EXCLUDE=true
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_MAX_API_ATTEMPTS=2
ENABLE_EXTERNAL_GROUNDEDNESS_AUDIT=false
# Optional global output cap; per-schema safe defaults are used when omitted.
# OPENROUTER_MAX_TOKENS=12000

# Add Gemini to race both providers and return the first schema-valid result:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=45

# Required for a public deployment. The Sites proxy sends this value to the API.
PROXY_AUTH_SECRET=

# Optional OpenAI fallback:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6
